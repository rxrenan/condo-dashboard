# A demo não precisa deste arquivo. O modo padrão é determinístico.
# PAINEL_MODO=deterministico

# Modo opcional com modelo. Não publica no painel.
# Exige as três variáveis. O fornecedor de um piloto é [A CONFIRMAR].
# A URL abaixo é só o formato chat/completions, compatível com vários fornecedores.
# PAINEL_MODO=llm
# PAINEL_LLM_BASE_URL=https://api.openai.com/v1
# PAINEL_LLM_MODEL=
# PAINEL_LLM_API_KEY=
