{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resumo mensal",
  "type": "object",
  "required": ["competencia", "texto", "fontes"],
  "properties": {
    "competencia": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "texto": { "type": "string", "minLength": 1 },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tipo", "arquivo"],
        "properties": {
          "tipo": { "enum": ["ata", "balancete", "registro"] },
          "arquivo": { "type": "string" }
        }
      }
    }
  }
}
